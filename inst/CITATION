pkgVer <- function(pkg) {
    if (!exists("meta") || is.null(meta)) meta <- packageDescription(pkg)
    ver <- meta$Version
    paste0(
        "https://github.com/maialba3/", pkg,
        " - R package version ", ver
    )
}

